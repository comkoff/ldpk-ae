mat3 wdg(vec3 n)
	{
	return mat3(
		0,	-n[2],	+n[1],
		+n[2],	0,	-n[0],
		-n[1],	+n[0],	0);
	}

mat3 tensq(vec3 n)
	{
	return mat3(
		n[0] * n[0],n[1] * n[0],n[2] * n[0],
		n[0] * n[1],n[1] * n[1],n[2] * n[1],
		n[0] * n[2],n[1] * n[2],n[2] * n[2]);
	}

mat3 make_rot_from_angle_and_axis(float phi,vec3 n)
	{
	vec3 unit_n = normalize(n);
	float c = cos(phi);
	float s = sin(phi);
	return    mat3(c,0,0,0,c,0,0,0,c)
		+ (1.0 - c) * tensq(unit_n)
		- wdg(s * unit_n);
	}
