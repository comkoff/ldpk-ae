Parameter "Rescale" = r_pa(recorded) / r_pa(production)

verify_distorted_ldopt.png
--------------------------

sdv_ldopt -in0 grid_distorted.png		-verify0 verify_distorted_ldopt.png		-model ld_3de4_anamorphic_standard_degree_6 -par fl_cm 1.0 -par w_fb_cm 2.0 -par h_fb_cm 1.0 -par x_lco_cm 0.3

verify_distorted_rescaled_ldopt.png
-----------------------------------

sdv_ldopt -in0 grid_distorted_rescaled.png	-verify0 verify_distorted_rescaled_ldopt.png	-model ld_3de4_anamorphic_rescaled_degree_6 -par fl_cm 1.0 -par w_fb_cm 2.0 -par h_fb_cm 1.0 -par x_lco_cm 0.3 -par Rescale none 1.5


